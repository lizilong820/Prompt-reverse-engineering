[Unit]
Description=Prompt Lens AI prompt reconstruction service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/prompt-lens
EnvironmentFile=/opt/prompt-lens/.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/prompt-lens/.playwright-browsers
ExecStart=/opt/prompt-lens/.venv/bin/uvicorn app.main:app --host ${APP_HOST} --port ${APP_PORT}
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
