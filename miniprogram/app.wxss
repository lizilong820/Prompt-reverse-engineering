page { background: #f2f0eb; color: #242421; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 28rpx 28rpx 80rpx; box-sizing: border-box; }
.eyebrow { color: #c64f35; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.section-title { margin-top: 8rpx; font-size: 38rpx; font-weight: 700; }
.muted { color: #77756e; }
.primary { display: flex; align-items: center; justify-content: center; height: 92rpx; border-radius: 12rpx; background: #242421; color: #fff; font-size: 28rpx; font-weight: 650; }
.primary[disabled] { opacity: .45; }
.secondary { display: flex; align-items: center; justify-content: center; height: 82rpx; border: 1rpx solid #d7d3cb; border-radius: 12rpx; background: #fbfaf7; color: #242421; font-size: 26rpx; }
.empty { padding: 100rpx 30rpx; color: #8a8881; text-align: center; font-size: 25rpx; }
