page { background: #f1eee8; color: #252522; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif; }
button::after { border: 0; }
button { line-height: 1; }
.page { min-height: 100vh; padding: 28rpx 30rpx 90rpx; box-sizing: border-box; }
.eyebrow { color: #bd4d35; font-size: 19rpx; font-weight: 800; letter-spacing: 2.5rpx; }
.section-title { margin-top: 10rpx; font-size: 42rpx; font-weight: 800; letter-spacing: -1rpx; }
.muted { color: #77746c; }
.primary { display: flex; align-items: center; justify-content: center; height: 94rpx; border-radius: 14rpx; color: #fff; background: #252522; font-size: 28rpx; font-weight: 700; box-shadow: 0 12rpx 22rpx rgba(37,37,34,.14); }
.primary[disabled] { color: #b6b2a9; background: #d9d5cd; box-shadow: none; }
.secondary { display: flex; align-items: center; justify-content: center; height: 82rpx; border: 1rpx solid #d8d3ca; border-radius: 12rpx; color: #383732; background: #fffdf9; font-size: 25rpx; }
.empty { padding: 120rpx 30rpx; color: #98938a; text-align: center; font-size: 25rpx; }
