page { background: #101110; color: #f3f5f1; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; letter-spacing: 0; }
button::after { border: 0; }
button { line-height: 1; }
.page { min-height: 100vh; padding: 22rpx 30rpx 70rpx; box-sizing: border-box; }
.eyebrow { color: #d8ff3e; font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; }
.section-title { margin-top: 8rpx; color: #f3f5f1; font-size: 42rpx; font-weight: 800; }
.muted { color: #969d96; }
.primary { display: flex; align-items: center; justify-content: center; min-height: 86rpx; border: 1rpx solid #d8ff3e; border-radius: 8rpx; color: #11130d; background: #d8ff3e; font-size: 27rpx; font-weight: 800; }
.primary[disabled] { color: #6f766f; border-color: #383d38; background: #222522; }
.secondary { display: flex; align-items: center; justify-content: center; min-height: 76rpx; border: 1rpx solid #383d38; border-radius: 8rpx; color: #f3f5f1; background: #222522; font-size: 24rpx; }
.empty { padding: 120rpx 30rpx; color: #98938a; text-align: center; font-size: 25rpx; }
