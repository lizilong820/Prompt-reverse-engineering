<view class="page tools-page">
  <view class="page-header"><view><text class="eyebrow">CREATIVE TOOLS</text><view class="section-title">工具</view></view><text class="count">{{computeCount}} 次算力</text></view>
  <view class="tool-card"><view class="tool-mark">D</view><view><strong>视频深度转换</strong><text>生成可用于后期和 ComfyUI 的深度视频</text></view></view>
  <view class="source-switch"><view class="source-item {{sourceMode === 'upload' ? 'active' : ''}}" data-source="upload" bindtap="chooseSource">本地上传</view><view class="source-item {{sourceMode === 'link' ? 'active' : ''}}" data-source="link" bindtap="chooseSource">粘贴链接</view></view>
  <view wx:if="{{sourceMode === 'upload'}}" class="media-box {{filePath ? 'has-file' : ''}}" bindtap="chooseVideo"><video wx:if="{{filePath}}" class="preview" src="{{filePath}}" controls /><view wx:else class="upload-empty"><view class="upload-icon">↑</view><text class="upload-title">点击选择动作视频</text><text class="upload-hint">支持 MP4 · MOV · WebM · MKV，最大 500MB</text></view></view>
  <view wx:else class="link-source"><textarea value="{{videoLink}}" bindinput="onLinkInput" maxlength="4096" placeholder="粘贴抖音、快手、小红书分享文本或视频直链" /><text>使用公开且有权处理的视频内容。</text></view>
  <view class="field-title">转换模式</view><view class="preset-grid"><view class="preset {{preset === 'quick_preview' ? 'active' : ''}}" data-preset="quick_preview" bindtap="choosePreset"><strong>快速预览</strong><text>快速生成</text></view><view class="preset {{preset === 'standard_depth' ? 'active' : ''}}" data-preset="standard_depth" bindtap="choosePreset"><strong>标准深度</strong><text>推荐模式</text></view><view class="preset {{preset === 'motion_character' ? 'active' : ''}}" data-preset="motion_character" bindtap="choosePreset"><strong>人物动作</strong><text>强化人体</text></view></view>
  <button class="primary" bindtap="submit" disabled="{{submitting || (sourceMode === 'upload' ? !filePath : !videoLink)}}">{{submitting ? '正在提交' : '消耗 1 次算力开始转换'}}</button>
  <view wx:if="{{job}}" class="job-state"><view class="job-title">{{job.status === 'completed' ? '转换完成' : job.status === 'failed' ? '转换失败' : job.message || '正在处理'}}</view><progress percent="{{job.progress || 0}}" active="{{job.status !== 'failed' && job.status !== 'completed'}}" stroke-width="6" /><text wx:if="{{job.error}}" class="error">{{job.error}}</text><button wx:if="{{job.status === 'completed'}}" class="secondary" bindtap="download">保存深度视频到相册</button></view>
</view>
