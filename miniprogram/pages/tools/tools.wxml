<view class="page tools-page">
  <view class="topline"><view class="brand"><view class="brand-mark">D/</view><view><text class="brand-name">视频深度转换</text><text class="brand-sub">动作深度视频工作台</text></view></view></view>
  <view class="balance-card"><view><text class="balance-label">可用算力次数</text><text class="balance-number">{{computeCount}}</text></view><button class="reward-button" bindtap="watchRewardAd" disabled="{{adLoading || adRemaining <= 0}}"><text wx:if="{{adRemaining > 0}}" class="reward-plus">🎬</text>{{adRemaining > 0 ? '看激励广告+1次' : '今日已领完'}}</button></view>
  <view class="heading"><text class="eyebrow">DEPTH MOTION</text><view class="section-title">深度转换</view></view>
  <view class="tool-mode"><text>深度视频</text><text>DEPTH VIDEO · 1 次</text></view>
  <view class="source-switch"><view class="source-item {{sourceMode === 'upload' ? 'active' : ''}}" data-source="upload" bindtap="chooseSource">本地上传</view><view class="source-item {{sourceMode === 'link' ? 'active' : ''}}" data-source="link" bindtap="chooseSource">粘贴链接</view></view>
  <view wx:if="{{resultVideoPath}}" class="media-box has-file result-preview"><video class="preview" src="{{resultVideoPath}}" controls catchtap="noop" /></view>
  <view wx:elif="{{previewLoading}}" class="media-box result-loading"><view class="upload-empty"><view class="upload-icon">D/</view><text class="upload-title">正在加载转换结果</text><text class="upload-hint">视频将在这里显示</text></view></view>
  <view wx:elif="{{sourceMode === 'upload'}}" class="media-box {{filePath ? 'has-file' : ''}}" bindtap="chooseVideo"><video wx:if="{{filePath}}" class="preview" src="{{filePath}}" controls catchtap="noop" /><view wx:else class="upload-empty"><view class="upload-icon">↑</view><text class="upload-title">点击选择动作视频</text><text class="upload-hint">MP4 · MOV · WEBM / 最大 180MB</text></view></view>
  <view wx:else class="link-source"><textarea value="{{videoLink}}" bindinput="onLinkInput" maxlength="4096" placeholder="粘贴抖音/快手/小红书/视频号分享链接，或输入视频直链" /><text>仅支持公开内容，私密或需登录的视频无法解析。</text></view>
  <view class="field-title">转换模式</view><view class="preset-grid"><view class="preset {{preset === 'quick_preview' ? 'active' : ''}}" data-preset="quick_preview" bindtap="choosePreset"><strong>快速预览</strong><text>快速生成</text></view><view class="preset {{preset === 'standard_depth' ? 'active' : ''}}" data-preset="standard_depth" bindtap="choosePreset"><strong>标准深度</strong><text>推荐模式</text></view><view class="preset {{preset === 'motion_character' ? 'active' : ''}}" data-preset="motion_character" bindtap="choosePreset"><strong>人物动作</strong><text>强化人体</text></view></view>
  <button class="primary" bindtap="submit" disabled="{{submitting || (sourceMode === 'upload' ? !filePath : !videoLink)}}">{{submitting ? '正在提交' : '消耗 1 次算力开始转换'}}</button>
  <view wx:if="{{job}}" class="job-state"><view class="job-title">{{job.status === 'completed' ? '转换完成' : job.status === 'expired' ? '结果已过期' : job.status === 'failed' ? '转换失败' : job.status === 'finalizing' ? '正在保存结果' : job.message || '正在处理'}}</view><progress percent="{{job.progress || 0}}" active="{{job.status !== 'failed' && job.status !== 'completed' && job.status !== 'expired'}}" stroke-width="6" /><text wx:if="{{job.error}}" class="error">{{job.error}}</text><text wx:if="{{job.status === 'completed' && job.expiresText}}" class="retention">结果保留至 {{job.expiresText}}</text><text wx:if="{{job.status === 'expired'}}" class="retention expired">转换视频仅保留 24 小时</text><button wx:if="{{job.status === 'completed' && job.download_url}}" class="secondary" bindtap="download">保存深度视频到相册</button></view>
</view>
