.tools-page { padding-top:14rpx; }
.topline { display:flex; align-items:center; justify-content:space-between; min-height:58rpx; padding-bottom:14rpx; border-bottom:1rpx solid #383d38; }
.brand { display:flex; align-items:center; gap:14rpx; }.brand-mark { width:50rpx; height:50rpx; line-height:50rpx; border-radius:6rpx; color:#11130d; background:#d8ff3e; text-align:center; font-size:20rpx; font-weight:900; }.brand-name,.brand-sub { display:block; }.brand-name { color:#f3f5f1; font-size:26rpx; font-weight:800; letter-spacing:1rpx; }.brand-sub { margin-top:5rpx; color:#969d96; font-size:18rpx; }
.avatar-dot { min-width:54rpx; height:46rpx; padding:0 10rpx; line-height:46rpx; border:1rpx solid #383d38; border-radius:6rpx; color:#d8ff3e; background:#191b19; text-align:center; font-size:20rpx; font-weight:800; }
.balance-card { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin-top:16rpx; padding:10rpx 16rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.balance-label { display:block; color:#969d96; font-size:17rpx; }.balance-number { display:block; margin-top:0; color:#d8ff3e; font-size:42rpx; font-weight:850; }
.reward-button { display:flex; align-items:center; justify-content:center; margin:0; padding:0 12rpx; height:42rpx; line-height:42rpx; border:1rpx solid #d8ff3e; border-radius:6rpx; color:#11130d; background:#d8ff3e; font-size:17rpx; font-weight:800; white-space:nowrap; }.reward-button[disabled] { color:#6f766f; border-color:#383d38; background:#222522; }.reward-plus { display:inline-flex; align-items:center; margin-right:4rpx; font-size:18rpx; line-height:1; }
.heading { margin:24rpx 0 14rpx; }.tool-mode { box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; height:60rpx; padding:0 14rpx; border:1rpx solid #383d38; border-radius:6rpx; color:#f3f5f1; background:#191b19; font-size:20rpx; }.tool-mode text:last-child { color:#969d96; font-size:17rpx; }
.source-switch { box-sizing:border-box; display:grid; grid-template-columns:1fr 1fr; gap:5rpx; height:60rpx; margin-top:10rpx; padding:4rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.source-item { box-sizing:border-box; display:flex; align-items:center; justify-content:center; height:50rpx; border:1rpx solid transparent; border-radius:4rpx; color:#969d96; font-size:21rpx; }.source-item.active { color:#11130d; border-color:#d8ff3e; background:#d8ff3e; font-weight:800; }
.media-box { box-sizing:border-box; width:100%; height:330rpx; margin-top:12rpx; overflow:hidden; border:1rpx dashed #4b514b; border-radius:6rpx; background:#141614; }.media-box.has-file { border-style:solid; border-color:#383d38; }.preview { width:100%; height:100%; }.upload-empty { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; }.upload-icon { width:60rpx; height:60rpx; line-height:56rpx; border:1rpx solid #d8ff3e; border-radius:4rpx; color:#d8ff3e; text-align:center; font-size:32rpx; }.upload-title { margin-top:13rpx; color:#f3f5f1; font-size:23rpx; font-weight:750; }.upload-hint { margin-top:7rpx; color:#969d96; font-size:17rpx; }
.result-preview,.result-loading { border-style:solid; }.result-loading { border-color:#d8ff3e; }
.link-source { display:flex; flex-direction:column; box-sizing:border-box; width:100%; height:330rpx; margin-top:12rpx; padding:14rpx; overflow:hidden; border:1rpx dashed #4b514b; border-radius:6rpx; background:#141614; }.link-source textarea { width:100%; flex:1; min-height:0; box-sizing:border-box; color:#f3f5f1; font-size:22rpx; line-height:1.45; }.link-source textarea::placeholder { color:#6f766f; }.link-source text { flex:none; margin-top:8rpx; color:#969d96; font-size:17rpx; }
.field-title { margin:18rpx 0 10rpx; color:#969d96; font-size:20rpx; font-weight:800; letter-spacing:1rpx; }.preset-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:6rpx; margin-bottom:18rpx; }.preset { min-height:76rpx; padding:12rpx 7rpx; border:1rpx solid #383d38; border-radius:4rpx; background:#141614; text-align:center; }.preset.active { border-color:#d8ff3e; background:#20251a; }.preset strong,.preset text { display:block; }.preset strong { color:#f3f5f1; font-size:21rpx; }.preset text { margin-top:6rpx; color:#969d96; font-size:17rpx; }.preset.active text { color:#d8ff3e; }
.job-state { margin-top:18rpx; padding:18rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.job-title { margin-bottom:15rpx; color:#f3f5f1; font-size:23rpx; font-weight:800; }.job-state progress { margin-bottom:15rpx; }.error { display:block; color:#ff6b57; font-size:20rpx; line-height:1.5; }.result-meta { display:block; margin-bottom:5rpx; color:#d8ff3e; font-size:19rpx; font-weight:800; line-height:1.5; }.retention { display:block; color:#969d96; font-size:18rpx; line-height:1.5; }.retention.expired { color:#ff6b57; }.job-state button { margin-top:16rpx; }
