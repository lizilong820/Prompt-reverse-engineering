.tools-page { padding-top: 24rpx; }.page-header { display:flex; justify-content:space-between; align-items:flex-end; }.count { color:#a94430; font-size:22rpx; font-weight:700; }.tool-card { display:flex; gap:20rpx; align-items:center; margin-top:30rpx; padding:26rpx; border-radius:16rpx; background:#252522; color:#fff; }.tool-mark { width:64rpx; height:64rpx; line-height:64rpx; text-align:center; border-radius:16rpx; color:#252522; background:#f3c9b9; font-size:30rpx; font-weight:800; }.tool-card strong,.tool-card text { display:block; }.tool-card text { margin-top:8rpx; color:#c7c4bd; font-size:21rpx; }.source-switch { display:grid; grid-template-columns:1fr 1fr; gap:8rpx; margin-top:24rpx; padding:6rpx; background:#e5e1d9; border-radius:12rpx; }.source-item { padding:20rpx; text-align:center; color:#77746c; border-radius:9rpx; font-size:24rpx; }.source-item.active { color:#252522; background:#fffdf9; font-weight:700; }.media-box { height:400rpx; margin-top:18rpx; overflow:hidden; border:2rpx dashed #c9c3b9; border-radius:18rpx; background:#e8e4dc; }.media-box.has-file { border:0; }.preview { width:100%; height:100%; }.upload-empty { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; }.upload-icon { width:78rpx; height:78rpx; line-height:70rpx; border:2rpx solid #d7836d; border-radius:50%; color:#ad452f; background:#f7e2da; text-align:center; font-size:44rpx; }.upload-title { margin-top:22rpx; font-size:28rpx; font-weight:750; }.upload-hint { margin-top:10rpx; color:#89847a; font-size:20rpx; }.link-source { margin-top:18rpx; padding:20rpx; border:1rpx solid #dedbd3; border-radius:14rpx; background:#fffdf9; }.link-source textarea { width:100%; min-height:160rpx; font-size:25rpx; line-height:1.5; }.link-source text { color:#89847a; font-size:20rpx; }.field-title { margin:28rpx 0 12rpx; font-size:24rpx; font-weight:700; }.preset-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10rpx; margin-bottom:28rpx; }.preset { padding:20rpx 8rpx; border:1rpx solid #dedbd3; border-radius:12rpx; text-align:center; background:#fffdf9; }.preset.active { border-color:#bd4d35; background:#f7e5de; }.preset strong,.preset text { display:block; }.preset strong { font-size:23rpx; }.preset text { margin-top:6rpx; color:#89847a; font-size:18rpx; }.job-state { margin-top:24rpx; padding:22rpx; border:1rpx solid #dedbd3; border-radius:14rpx; background:#fffdf9; }.job-title { margin-bottom:18rpx; font-weight:700; }.job-state progress { margin-bottom:18rpx; }.error { display:block; color:#b34630; font-size:22rpx; line-height:1.5; }.job-state button { margin-top:18rpx; }
