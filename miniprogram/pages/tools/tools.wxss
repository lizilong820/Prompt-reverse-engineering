.tools-page { padding-top:22rpx; }
.page-header { display:flex; align-items:flex-end; justify-content:space-between; padding-bottom:20rpx; border-bottom:1rpx solid #383d38; }
.count { color:#d8ff3e; font-size:20rpx; font-weight:800; }
.tool-card { display:flex; align-items:center; gap:16rpx; margin-top:22rpx; padding:20rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }
.tool-mark { width:58rpx; height:58rpx; line-height:58rpx; border-radius:4rpx; color:#11130d; background:#d8ff3e; text-align:center; font-size:26rpx; font-weight:900; }
.tool-card strong,.tool-card text { display:block; }.tool-card strong { color:#f3f5f1; font-size:25rpx; }.tool-card text { margin-top:6rpx; color:#969d96; font-size:19rpx; }
.tools-page > .source-switch { margin-top:18rpx; }.source-item { justify-content:center; }
.media-box { height:390rpx; margin-top:16rpx; overflow:hidden; border:1rpx dashed #4b514b; border-radius:6rpx; background:#141614; }.media-box.has-file { border-style:solid; border-color:#383d38; }.preview { width:100%; height:100%; }.upload-empty { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; }.upload-icon { width:70rpx; height:70rpx; line-height:66rpx; border:1rpx solid #d8ff3e; border-radius:4rpx; color:#d8ff3e; text-align:center; font-size:38rpx; }.upload-title { margin-top:17rpx; color:#f3f5f1; font-size:25rpx; font-weight:750; }.upload-hint { margin-top:8rpx; color:#969d96; font-size:18rpx; }
.link-source { margin-top:16rpx; padding:18rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.link-source textarea { width:100%; min-height:145rpx; color:#f3f5f1; font-size:23rpx; line-height:1.5; }.link-source text { color:#969d96; font-size:18rpx; }
.field-title { margin:24rpx 0 11rpx; color:#969d96; font-size:20rpx; font-weight:800; letter-spacing:1rpx; }.preset-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:6rpx; margin-bottom:22rpx; }.preset { min-height:82rpx; padding:13rpx 7rpx; border:1rpx solid #383d38; border-radius:4rpx; background:#141614; text-align:center; }.preset.active { border-color:#d8ff3e; background:#20251a; }.preset strong,.preset text { display:block; }.preset strong { color:#f3f5f1; font-size:21rpx; }.preset text { margin-top:6rpx; color:#969d96; font-size:17rpx; }.preset.active text { color:#d8ff3e; }
.job-state { margin-top:18rpx; padding:18rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.job-title { margin-bottom:15rpx; color:#f3f5f1; font-size:23rpx; font-weight:800; }.job-state progress { margin-bottom:15rpx; }.error { display:block; color:#ff6b57; font-size:20rpx; line-height:1.5; }.job-state button { margin-top:16rpx; }
