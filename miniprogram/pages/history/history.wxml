<view class="page">
  <view class="page-header"><view><text class="eyebrow">YOUR JOBS</text><view class="section-title">分析记录</view></view><text class="count">{{jobs.length}} 条</text></view>
  <view wx:if="{{jobs.length}}" class="jobs">
    <view class="job" wx:for="{{jobs}}" wx:key="id" data-id="{{item.id}}" bindtap="openJob">
      <view class="job-top"><text class="mode">{{item.mode === 'video' ? '视频' : '图片'}}</text><text class="status {{item.status}}">{{item.statusText}}</text></view>
      <view class="filename">{{item.filename}}</view>
      <view class="job-meta"><text>{{item.cost}} 次算力</text><text>{{item.createdText}}</text></view>
    </view>
  </view>
  <view wx:else class="empty">还没有分析记录</view>
</view>
