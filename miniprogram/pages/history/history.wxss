.page-header { display:flex; align-items:flex-end; justify-content:space-between; padding-bottom:20rpx; border-bottom:1rpx solid #383d38; }.count { color:#d8ff3e; font-size:20rpx; font-weight:800; }
.records { display:grid; gap:8rpx; margin-top:16rpx; }.record { display:flex; align-items:center; gap:14rpx; min-height:104rpx; padding:14rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.record.clickable { border-color:#4b514b; }.record-mark { width:50rpx; height:50rpx; line-height:50rpx; flex:none; border-radius:4rpx; color:#11130d; background:#d8ff3e; text-align:center; font-size:18rpx; font-weight:900; }.record-copy { min-width:0; flex:1; }.record-copy strong,.record-copy text,.record-copy small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.record-copy strong { color:#f3f5f1; font-size:22rpx; }.record-copy text { margin-top:5rpx; color:#969d96; font-size:18rpx; }.record-copy small { margin-top:5rpx; color:#6f766f; font-size:16rpx; }.record-state { flex:none; color:#d8ff3e; font-size:18rpx; }.record-state.failed { color:#ff6b57; }
