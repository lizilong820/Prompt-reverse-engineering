<view class="page" wx:if="{{job}}">
  <view class="result-head"><view><text class="eyebrow">ANALYSIS RESULT</text><view class="section-title">{{isImageExpansion ? '10秒视频提示词' : job.mode === 'video' ? '视频分镜' : '图片提示词'}}</view><text class="result-file">{{job.filename}}</text></view><text class="confidence">{{analysis.confidence}}<small>%</small></text></view>
  <view class="facts"><view class="fact" wx:for="{{facts}}" wx:key="label"><text>{{item.label}}</text><view>{{item.value}}</view></view></view>
  <view wx:if="{{analysis.timeline.length}}" class="timeline"><view class="block-title">{{isImageExpansion ? '10秒画面拓展' : '视频分镜'}}</view><view class="segment" wx:for="{{analysis.timeline}}" wx:key="start"><text>{{item.start}} - {{item.end}}</text><view>{{item.description}}</view><small>镜头：{{item.camera_motion}} · 主体：{{item.subject_motion}}</small></view></view>
  <view class="prompt-block"><view class="prompt-head"><text class="block-title">生成提示词</text><view class="prompt-actions"><button bindtap="copyPrompt">复制</button><button bindtap="saveProject" disabled="{{projectSaving}}">{{project ? '更新项目' : '收藏项目'}}</button></view></view><scroll-view wx:if="{{platformOptions.length > 1}}" class="platform-switch" scroll-x="true"><view wx:for="{{platformOptions}}" wx:key="key" class="platform-item {{platform === item.key ? 'active' : ''}}" data-platform="{{item.key}}" bindtap="switchPlatform">{{item.label}}</view></scroll-view><scroll-view wx:if="{{versionOptions.length > 1}}" class="version-switch" scroll-x="true"><view wx:for="{{versionOptions}}" wx:key="key" class="version-item {{versionKey === item.key ? 'active' : ''}}" data-version="{{item.key}}" bindtap="switchVersion">{{item.label}}</view></scroll-view><view class="language-switch"><button class="{{language === 'zh' ? 'active' : ''}}" data-language="zh" bindtap="switchLanguage">中文</button><button class="{{language === 'en' ? 'active' : ''}}" data-language="en" bindtap="switchLanguage">English</button></view><text selectable>{{prompt}}</text></view>
  <view class="optimization-block"><view class="optimization-head"><view><text class="block-title">二次优化</text><small>基于当前结果，不重复分析素材</small></view><text>{{optimizationCost}} 次/次</text></view><view class="optimization-grid"><button wx:for="{{optimizationStrategies}}" wx:key="key" data-strategy="{{item.key}}" bindtap="optimizePrompt" disabled="{{optimizing}}">{{item.label}}</button></view><view wx:if="{{optimizing}}" class="optimization-state"><text>正在优化当前提示词</text><progress active percent="70" stroke-width="4" /></view><text class="optimization-balance">当前可用 {{computeCount}} 次算力</text></view>
</view>
<view wx:else class="empty">{{errorMessage || '正在加载结果'}}</view>
