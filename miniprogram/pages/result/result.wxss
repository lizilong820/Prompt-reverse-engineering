.result-head { display:flex; align-items:flex-start; justify-content:space-between; padding-bottom:20rpx; border-bottom:1rpx solid #383d38; }.result-file { display:block; max-width:480rpx; margin-top:10rpx; overflow:hidden; color:#969d96; text-overflow:ellipsis; white-space:nowrap; font-size:19rpx; }.confidence { padding:11rpx 14rpx; border:1rpx solid #d8ff3e; border-radius:4rpx; color:#11130d; background:#d8ff3e; font-size:30rpx; font-weight:900; }.confidence small { margin-left:3rpx; font-size:18rpx; }
.facts { display:grid; gap:6rpx; margin-top:20rpx; }.fact { padding:18rpx; border:1rpx solid #383d38; border-radius:4rpx; background:#191b19; }.fact text,.block-title { color:#969d96; font-size:18rpx; font-weight:800; letter-spacing:1rpx; }.fact view { margin-top:8rpx; color:#f3f5f1; font-size:23rpx; line-height:1.55; }
.timeline,.prompt-block { margin-top:20rpx; padding:20rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.segment { margin-top:15rpx; padding-left:14rpx; border-left:3rpx solid #d8ff3e; }.segment text { color:#d8ff3e; font-size:20rpx; font-weight:800; }.segment view { margin:7rpx 0; color:#f3f5f1; font-size:23rpx; line-height:1.5; }.segment small { color:#969d96; font-size:18rpx; }
.prompt-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:15rpx; }.prompt-head button { margin:0; padding:0 17rpx; height:52rpx; line-height:52rpx; border:1rpx solid #d8ff3e; border-radius:4rpx; color:#11130d; background:#d8ff3e; font-size:19rpx; font-weight:800; }.prompt-block > text { color:#f3f5f1; font-size:23rpx; line-height:1.7; }.language-switch { display:flex; gap:6rpx; margin-bottom:14rpx; }.language-switch button { margin:0; padding:0 16rpx; height:48rpx; line-height:48rpx; border:1rpx solid #383d38; border-radius:4rpx; color:#969d96; background:#141614; font-size:19rpx; }.language-switch button.active { border-color:#d8ff3e; color:#11130d; background:#d8ff3e; font-weight:800; }
