.profile-head { display:flex; align-items:center; gap:14rpx; padding-bottom:20rpx; border-bottom:1rpx solid #383d38; }
.avatar { width:58rpx; height:58rpx; line-height:58rpx; border-radius:4rpx; color:#11130d; background:#d8ff3e; text-align:center; font-size:21rpx; font-weight:900; }
.balance { margin-top:22rpx; padding:24rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.balance text,.balance small { display:block; color:#969d96; font-size:20rpx; }.balance strong { display:block; margin:6rpx 0 12rpx; color:#d8ff3e; font-size:66rpx; }
.ledger-title { margin-top:32rpx; padding-top:18rpx; border-top:1rpx solid #383d38; }.stats { display:grid; grid-template-columns:repeat(3,1fr); gap:6rpx; margin-top:14rpx; }.stats view { padding:16rpx 6rpx; border:1rpx solid #383d38; border-radius:4rpx; background:#141614; text-align:center; }.stats strong,.stats text { display:block; }.stats strong { color:#f3f5f1; font-size:30rpx; }.stats text { margin-top:5rpx; color:#969d96; font-size:17rpx; }
.recent { margin-top:15rpx; border-top:1rpx solid #383d38; }.recent-item { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding:18rpx 2rpx; border-bottom:1rpx solid #383d38; }.recent-item strong,.recent-item small { display:block; }.recent-item strong { color:#f3f5f1; font-size:22rpx; }.recent-item small { max-width:450rpx; margin-top:5rpx; overflow:hidden; color:#969d96; text-overflow:ellipsis; white-space:nowrap; font-size:18rpx; }.recent-item > text { color:#d8ff3e; font-size:19rpx; }
.ledger { margin-top:15rpx; border-top:1rpx solid #383d38; }.entry { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding:20rpx 2rpx; border-bottom:1rpx solid #383d38; }.entry strong,.entry small { display:block; }.entry strong { color:#f3f5f1; font-size:23rpx; }.entry small { margin-top:6rpx; color:#969d96; font-size:18rpx; }.amount { text-align:right; font-size:28rpx; font-weight:800; }.amount.plus { color:#d8ff3e; }.amount.minus { color:#ff6b57; }
