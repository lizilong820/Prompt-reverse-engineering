.balance { padding: 34rpx; border-radius: 14rpx; color: #fff; background: #242421; }.balance text, .balance small { display: block; color: #c7c4bd; font-size: 22rpx; }.balance strong { display: block; margin: 8rpx 0 14rpx; font-size: 72rpx; }.ledger-title { margin-top: 42rpx; }
.ledger { margin-top: 24rpx; border-top: 1rpx solid #dedbd3; }.entry { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 2rpx; border-bottom: 1rpx solid #dedbd3; }.entry strong, .entry small { display: block; }.entry strong { font-size: 25rpx; }.entry small { margin-top: 7rpx; color: #77756e; font-size: 20rpx; }.amount { text-align: right; font-size: 30rpx; font-weight: 700; }.amount.plus { color: #44705e; }.amount.minus { color: #b34630; }
