.profile-head { display: flex; align-items: center; gap: 16rpx; }.avatar { width: 66rpx; height: 66rpx; line-height: 66rpx; border-radius: 18rpx; color: #fff; background: #252522; text-align: center; font-size: 22rpx; font-weight: 800; }
.balance { margin-top: 30rpx; padding: 34rpx; border-radius: 18rpx; color: #fff; background: #252522; box-shadow: 0 18rpx 30rpx rgba(37,37,34,.14); }.balance text, .balance small { display: block; color: #c7c4bd; font-size: 22rpx; }.balance strong { display: block; margin: 8rpx 0 14rpx; font-size: 72rpx; }.ledger-title { margin-top: 42rpx; }
.stats { display:grid; grid-template-columns:repeat(3,1fr); gap:10rpx; margin-top:18rpx; }.stats view { padding:20rpx 8rpx; border:1rpx solid #dedbd3; border-radius:12rpx; background:#fffdf9; text-align:center; }.stats strong,.stats text { display:block; }.stats strong { font-size:34rpx; }.stats text { margin-top:5rpx; color:#77756e; font-size:19rpx; }.recent { margin-top:20rpx; border-top:1rpx solid #dedbd3; }.recent-item { display:flex; justify-content:space-between; align-items:center; padding:20rpx 2rpx; border-bottom:1rpx solid #dedbd3; }.recent-item strong,.recent-item small { display:block; }.recent-item small { margin-top:5rpx; max-width:450rpx; overflow:hidden; color:#77756e; text-overflow:ellipsis; white-space:nowrap; font-size:19rpx; }.recent-item > text { color:#44705e; font-size:21rpx; }
.ledger { margin-top: 24rpx; border-top: 1rpx solid #dedbd3; }.entry { display: flex; justify-content: space-between; align-items: center; padding: 25rpx 2rpx; border-bottom: 1rpx solid #dedbd3; }.entry strong, .entry small { display: block; }.entry strong { font-size: 25rpx; }.entry small { margin-top: 7rpx; color: #77756e; font-size: 20rpx; }.amount { text-align: right; font-size: 30rpx; font-weight: 700; }.amount.plus { color: #44705e; }.amount.minus { color: #b34630; }
