.profile-head { display:flex; align-items:center; gap:14rpx; padding-bottom:20rpx; border-bottom:1rpx solid #383d38; }
.avatar { width:58rpx; height:58rpx; line-height:58rpx; border-radius:4rpx; color:#11130d; background:#d8ff3e; text-align:center; font-size:21rpx; font-weight:900; }
.balance { box-sizing:border-box; width:100%; margin-top:22rpx; padding:24rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.balance text,.balance small { display:block; color:#969d96; font-size:20rpx; }.balance strong { display:block; margin:6rpx 0 12rpx; color:#d8ff3e; font-size:66rpx; }
.stats { box-sizing:border-box; width:100%; display:grid; grid-template-columns:repeat(3,1fr); gap:6rpx; margin-top:14rpx; }.stats view { padding:16rpx 6rpx; border:1rpx solid #383d38; border-radius:4rpx; background:#141614; text-align:center; }.stats strong,.stats text { display:block; }.stats strong { color:#f3f5f1; font-size:30rpx; }.stats text { margin-top:5rpx; color:#969d96; font-size:17rpx; }
.menu-section { box-sizing:border-box; width:100%; display:grid; gap:10rpx; margin-top:28rpx; padding-top:20rpx; border-top:1rpx solid #383d38; }.menu-button { box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; width:100%; min-height:108rpx; margin:0; padding:0 20rpx; border:1rpx solid #383d38; border-radius:6rpx; color:#f3f5f1; background:#191b19; text-align:left; }.menu-button view { min-width:0; }.menu-title,.menu-meta { display:block; }.menu-title { font-size:24rpx; font-weight:800; }.menu-meta { margin-top:7rpx; color:#969d96; font-size:18rpx; }.menu-arrow { flex:none; color:#d8ff3e; font-size:42rpx; font-weight:400; }
