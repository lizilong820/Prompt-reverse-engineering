<view class="page index-page">
  <view class="topline"><view class="brand"><view class="brand-mark">PL</view><view><text class="brand-name">Prompt Lens</text><text class="brand-sub">视觉提示词工作台</text></view></view><view class="avatar-dot">{{credits}}</view></view>
  <view class="balance-card"><view><text class="balance-label">可用积分</text><text class="balance-number">{{credits}}</text></view><button class="reward-button" bindtap="watchRewardAd" disabled="{{adLoading}}"><text class="reward-plus">＋</text>看广告得 {{adReward}} 分</button></view>
  <view class="heading"><text class="eyebrow">PROMPT RECONSTRUCTION</text><view class="section-title">把画面变成提示词</view><text class="intro">上传一张图片或一段视频，提取可复用的视觉描述。</text></view>
  <view class="mode-switch"><view class="mode-item {{mode === 'image' ? 'active' : ''}}" data-mode="image" bindtap="switchMode"><text class="mode-icon">▧</text><text>图片</text><text class="mode-cost">{{pricing.image}} 分</text></view><view class="mode-item {{mode === 'video' ? 'active' : ''}}" data-mode="video" bindtap="switchMode"><text class="mode-icon">▷</text><text>视频</text><text class="mode-cost">{{pricing.video}} 分</text></view></view>
  <view class="media-box {{filePath ? 'has-file' : ''}}" bindtap="chooseMedia"><image wx:if="{{mode === 'image' && filePath}}" class="preview" src="{{filePath}}" mode="aspectFill" /><video wx:if="{{mode === 'video' && filePath}}" class="preview" src="{{filePath}}" controls /><view wx:else class="upload-empty"><view class="upload-icon">↑</view><text class="upload-title">点击选择{{mode === 'image' ? '图片' : '视频'}}</text><text class="upload-hint">{{mode === 'image' ? 'JPG · PNG · WEBP  /  最大 12MB' : 'MP4 · MOV · WEBM  /  最大 180MB'}}</text></view></view>
  <view wx:if="{{fileName}}" class="file-meta"><text class="file-name">{{fileName}}</text><text>{{fileSize}}</text></view>
  <view class="flow"><view class="flow-item active"><text>01</text><label>上传</label></view><view class="flow-line"></view><view class="flow-item"><text>02</text><label>拆解</label></view><view class="flow-line"></view><view class="flow-item"><text>03</text><label>输出</label></view></view>
  <button class="primary submit" bindtap="submit" disabled="{{!filePath || submitting}}">{{submitting ? '正在分析 ' + progress + '%' : '消耗 ' + currentCost + ' 积分开始分析'}}</button>
  <button wx:if="{{credits < currentCost}}" class="secondary ad-action" bindtap="watchRewardAd">积分不足 · 看广告获取积分</button>
  <view class="notice">分析失败自动退款 · 重复点击不会重复扣费</view>
</view>
