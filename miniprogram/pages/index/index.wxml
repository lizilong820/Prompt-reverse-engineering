<view class="page index-page">
  <view class="topline"><view class="brand"><view class="brand-mark">PL</view><view><text class="brand-name">AI提示词反推助手</text><text class="brand-sub">视觉提示词工作台</text></view></view><view class="avatar-dot">{{computeCount}}</view></view>
  <view class="balance-card"><view><text class="balance-label">可用算力次数</text><text class="balance-number">{{computeCount}}</text></view><button class="reward-button" bindtap="watchRewardAd" disabled="{{adLoading || adRemaining <= 0}}"><text class="reward-plus">＋</text>{{adRemaining > 0 ? '看广告加 1 次' : '今日已领完'}}</button></view>
  <view class="heading"><text class="eyebrow">PROMPT RECONSTRUCTION</text><view class="section-title">把画面变成提示词</view></view>
  <view class="mode-switch"><view class="mode-item {{mode === 'image' ? 'active' : ''}}" data-mode="image" bindtap="switchMode"><text class="mode-icon">▧</text><text>图片反推</text><text class="mode-cost">1 次</text></view><view class="mode-item {{mode === 'video' ? 'active' : ''}}" data-mode="video" bindtap="switchMode"><text class="mode-icon">▷</text><text>视频反推</text><text class="mode-cost">1 次</text></view></view>
  <view wx:if="{{mode === 'video'}}" class="source-switch"><view class="source-item {{sourceMode === 'upload' ? 'active' : ''}}" data-source="upload" bindtap="switchSource">本地上传</view><view class="source-item {{sourceMode === 'link' ? 'active' : ''}}" data-source="link" bindtap="switchSource">粘贴链接</view></view>
  <block wx:if="{{sourceMode === 'upload'}}"><view class="media-box {{filePath ? 'has-file' : ''}}" bindtap="chooseMedia"><image wx:if="{{mode === 'image' && filePath}}" class="preview" src="{{filePath}}" mode="aspectFill" /><video wx:if="{{mode === 'video' && filePath}}" class="preview" src="{{filePath}}" controls /><view wx:else class="upload-empty"><view class="upload-icon">↑</view><text class="upload-title">点击选择{{mode === 'image' ? '图片' : '视频'}}</text><text class="upload-hint">{{mode === 'image' ? 'JPG · PNG · WEBP / 最大 12MB' : 'MP4 · MOV · WEBM / 最大 180MB'}}</text></view></view><view wx:if="{{fileName}}" class="file-meta"><text class="file-name">{{fileName}}</text><text>{{fileSize}}</text></view></block>
  <view wx:else class="link-source"><textarea value="{{videoLink}}" bindinput="onVideoLinkInput" maxlength="4096" placeholder="粘贴分享文本或输入公开视频直链" /><text>仅支持公开内容，私密或需登录的视频无法解析。</text></view>
  <view class="flow"><view class="flow-item active"><text>01</text><label>上传</label></view><view class="flow-line"></view><view class="flow-item {{submitting ? 'active' : ''}}"><text>02</text><label>拆解</label></view><view class="flow-line"></view><view class="flow-item"><text>03</text><label>输出</label></view></view>
  <button class="primary submit" bindtap="submit" disabled="{{submitting || (sourceMode === 'upload' ? !filePath : !videoLink)}}">{{submitting ? '正在提交 ' + progress + '%' : '消耗 1 次算力开始反推'}}</button>
  <button wx:if="{{computeCount < 1}}" class="secondary ad-action" bindtap="watchRewardAd">次数不足 · 看广告增加 1 次</button>
  <view class="notice">分析失败自动返还 · 每日最多观看 20 次激励广告</view>
</view>
