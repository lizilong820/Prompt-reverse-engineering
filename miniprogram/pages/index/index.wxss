.index-page { padding-top: 22rpx; }
.topline { display:flex; align-items:center; justify-content:space-between; min-height:64rpx; padding-bottom:22rpx; border-bottom:1rpx solid #383d38; }
.brand { display:flex; align-items:center; gap:14rpx; }
.brand-mark { width:56rpx; height:56rpx; line-height:56rpx; border-radius:6rpx; color:#11130d; background:#d8ff3e; text-align:center; font-size:22rpx; font-weight:900; }
.brand-name,.brand-sub { display:block; }.brand-name { color:#f3f5f1; font-size:26rpx; font-weight:800; letter-spacing:1rpx; }.brand-sub { margin-top:5rpx; color:#969d96; font-size:18rpx; }
.avatar-dot { min-width:54rpx; height:46rpx; padding:0 10rpx; line-height:46rpx; border:1rpx solid #383d38; border-radius:6rpx; color:#d8ff3e; background:#191b19; text-align:center; font-size:20rpx; font-weight:800; }
.balance-card { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin-top:24rpx; padding:24rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }
.balance-label { display:block; color:#969d96; font-size:19rpx; }.balance-number { display:block; margin-top:5rpx; color:#d8ff3e; font-size:58rpx; font-weight:850; }
.reward-button { margin:0; padding:0 17rpx; min-height:56rpx; border:1rpx solid #d8ff3e; border-radius:6rpx; color:#11130d; background:#d8ff3e; font-size:20rpx; font-weight:800; }.reward-button[disabled] { color:#6f766f; border-color:#383d38; background:#222522; }.reward-plus { margin-right:4rpx; font-size:22rpx; }
.heading { margin:36rpx 0 22rpx; }.intro { display:block; max-width:610rpx; margin-top:12rpx; color:#969d96; font-size:23rpx; line-height:1.55; }
.workflow-label { margin:18rpx 0 10rpx; color:#969d96; font-size:19rpx; font-weight:800; letter-spacing:1rpx; }
.mode-switch,.source-switch { display:grid; grid-template-columns:1fr 1fr; gap:6rpx; padding:5rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.mode-item,.source-item { display:flex; align-items:center; gap:8rpx; min-height:58rpx; padding:0 14rpx; border:1rpx solid transparent; border-radius:4rpx; color:#969d96; font-size:23rpx; }.mode-item.active,.source-item.active { color:#11130d; border-color:#d8ff3e; background:#d8ff3e; font-weight:800; }.mode-icon { color:#d8ff3e; font-size:25rpx; }.mode-item.active .mode-icon { color:#11130d; }.mode-cost { margin-left:auto; color:#969d96; font-size:18rpx; }.mode-item.active .mode-cost { color:#11130d; }.index-page > .source-switch { margin-top:14rpx; }
.media-box { height:500rpx; margin-top:16rpx; overflow:hidden; border:1rpx dashed #4b514b; border-radius:6rpx; background:#141614; }.media-box.has-file { border-style:solid; border-color:#383d38; }.preview { width:100%; height:100%; }.upload-empty { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; }.upload-icon { width:72rpx; height:72rpx; line-height:68rpx; border:1rpx solid #d8ff3e; border-radius:4rpx; color:#d8ff3e; text-align:center; font-size:38rpx; }.upload-title { margin-top:18rpx; color:#f3f5f1; font-size:26rpx; font-weight:750; }.upload-hint { margin-top:9rpx; color:#969d96; font-size:19rpx; }.file-meta { display:flex; justify-content:space-between; gap:20rpx; padding:13rpx 2rpx 0; color:#969d96; font-size:19rpx; }.file-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.link-source { margin-top:16rpx; padding:18rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.link-source textarea { width:100%; min-height:150rpx; color:#f3f5f1; font-size:24rpx; line-height:1.5; }.link-source textarea::placeholder { color:#6f766f; }.link-source text { color:#969d96; font-size:19rpx; }
.dimension-section { margin-top:24rpx; padding-top:20rpx; border-top:1rpx solid #383d38; }.field-title { margin-bottom:12rpx; color:#969d96; font-size:20rpx; font-weight:800; letter-spacing:1rpx; }.dimension-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:6rpx; }.dimension { min-height:92rpx; padding:13rpx 9rpx; border:1rpx solid #383d38; border-radius:4rpx; background:#141614; text-align:center; }.dimension.active { border-color:#d8ff3e; background:#20251a; }.dimension strong,.dimension text { display:block; }.dimension strong { color:#f3f5f1; font-size:22rpx; }.dimension text { margin-top:7rpx; color:#969d96; font-size:17rpx; line-height:1.35; }.dimension.active text { color:#d8ff3e; }
.output-note { display:flex; align-items:center; justify-content:space-between; gap:14rpx; margin:18rpx 0; padding:14rpx 16rpx; border-left:3rpx solid #d8ff3e; background:#191b19; }.output-note strong { color:#d8ff3e; font-size:20rpx; }.output-note text { color:#969d96; font-size:19rpx; }.ad-action { margin-top:12rpx; }.notice { margin-top:14rpx; color:#6f766f; text-align:center; font-size:18rpx; }
