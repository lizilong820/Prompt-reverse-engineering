.account-bar { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 24rpx; border: 1rpx solid #dedbd3; border-radius: 12rpx; background: #fbfaf7; }
.account-label { display: block; color: #77756e; font-size: 21rpx; }
.credit-number { display: block; margin-top: 3rpx; font-size: 46rpx; font-weight: 750; }
.reward-button { margin: 0; padding: 0 24rpx; height: 66rpx; line-height: 66rpx; border-radius: 10rpx; color: #31594a; background: #e0ece5; font-size: 24rpx; font-weight: 650; }
.heading { margin: 44rpx 0 32rpx; }
.intro { display: block; margin-top: 15rpx; color: #77756e; font-size: 25rpx; line-height: 1.6; }
.mode-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 8rpx; padding: 7rpx; border-radius: 12rpx; background: #e7e4dd; }
.mode-item { padding: 20rpx 10rpx; border-radius: 8rpx; color: #77756e; text-align: center; font-size: 25rpx; }
.mode-item.active { color: #242421; background: #fff; box-shadow: 0 4rpx 12rpx rgba(45,40,32,.08); font-weight: 650; }
.media-box { height: 620rpx; margin-top: 20rpx; overflow: hidden; border: 2rpx dashed #c9c5bc; border-radius: 14rpx; background: #e8e5de; }
.preview { width: 100%; height: 100%; }
.upload-empty { height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; }
.upload-icon { width: 72rpx; height: 72rpx; line-height: 72rpx; border-radius: 50%; color: #a83f2b; background: #f2ded6; text-align: center; font-size: 42rpx; }
.upload-title { margin-top: 22rpx; font-size: 28rpx; font-weight: 650; }
.upload-hint { margin-top: 10rpx; color: #77756e; font-size: 21rpx; }
.file-meta { display: flex; justify-content: space-between; padding: 14rpx 4rpx; color: #77756e; font-size: 21rpx; }
.submit { margin-top: 26rpx; }
.ad-action { margin-top: 14rpx; }
.notice { margin-top: 18rpx; color: #77756e; text-align: center; font-size: 21rpx; }
