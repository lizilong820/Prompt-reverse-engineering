.index-page { padding-top: 14rpx; }
.topline { display:flex; align-items:center; justify-content:space-between; min-height:58rpx; padding-bottom:14rpx; border-bottom:1rpx solid #383d38; }
.brand { display:flex; align-items:center; gap:14rpx; }
.brand-mark { width:50rpx; height:50rpx; line-height:50rpx; border-radius:6rpx; color:#11130d; background:#d8ff3e; text-align:center; font-size:20rpx; font-weight:900; }
.brand-name,.brand-sub { display:block; }.brand-name { color:#f3f5f1; font-size:26rpx; font-weight:800; letter-spacing:1rpx; }.brand-sub { margin-top:5rpx; color:#969d96; font-size:18rpx; }
.avatar-dot { min-width:54rpx; height:46rpx; padding:0 10rpx; line-height:46rpx; border:1rpx solid #383d38; border-radius:6rpx; color:#d8ff3e; background:#191b19; text-align:center; font-size:20rpx; font-weight:800; }
.balance-card { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin-top:16rpx; padding:10rpx 16rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }
.balance-label { display:block; color:#969d96; font-size:17rpx; }.balance-number { display:block; margin-top:0; color:#d8ff3e; font-size:42rpx; font-weight:850; }
.reward-button { display:flex; align-items:center; justify-content:center; margin:0; padding:0 12rpx; height:42rpx; line-height:42rpx; border:1rpx solid #d8ff3e; border-radius:6rpx; color:#11130d; background:#d8ff3e; font-size:17rpx; font-weight:800; white-space:nowrap; }.reward-button[disabled] { color:#6f766f; border-color:#383d38; background:#222522; }.reward-plus { display:inline-flex; align-items:center; margin-right:4rpx; font-size:18rpx; line-height:1; }
.heading { margin:24rpx 0 14rpx; }.intro { display:none; }
.mode-switch,.source-switch { display:grid; grid-template-columns:1fr 1fr; gap:5rpx; padding:4rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.mode-item,.source-item { display:flex; align-items:center; gap:7rpx; min-height:48rpx; padding:0 12rpx; border:1rpx solid transparent; border-radius:4rpx; color:#969d96; font-size:21rpx; }.mode-item.active,.source-item.active { color:#11130d; border-color:#d8ff3e; background:#d8ff3e; font-weight:800; }.mode-icon { color:#d8ff3e; font-size:23rpx; }.mode-item.active .mode-icon { color:#11130d; }.mode-cost { margin-left:auto; color:#969d96; font-size:17rpx; }.mode-item.active .mode-cost { color:#11130d; }.index-page > .source-switch { box-sizing:border-box; height:60rpx; margin-top:10rpx; }.source-switch .source-item { box-sizing:border-box; min-height:0; height:50rpx; }
.source-switch-spacer { box-sizing:border-box; height:60rpx; margin-top:10rpx; visibility:hidden; }
.media-box { box-sizing:border-box; width:100%; height:330rpx; margin-top:12rpx; overflow:hidden; border:1rpx dashed #4b514b; border-radius:6rpx; background:#141614; }.media-box.has-file { border-style:solid; border-color:#383d38; }.preview { width:100%; height:100%; }.upload-empty { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; }.upload-icon { width:60rpx; height:60rpx; line-height:56rpx; border:1rpx solid #d8ff3e; border-radius:4rpx; color:#d8ff3e; text-align:center; font-size:32rpx; }.upload-title { margin-top:13rpx; color:#f3f5f1; font-size:23rpx; font-weight:750; }.upload-hint { margin-top:7rpx; color:#969d96; font-size:17rpx; }.file-meta { display:flex; justify-content:space-between; gap:20rpx; padding:9rpx 2rpx 0; color:#969d96; font-size:17rpx; }.file-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.link-source { display:flex; flex-direction:column; box-sizing:border-box; width:100%; height:330rpx; margin-top:12rpx; padding:14rpx; overflow:hidden; border:1rpx dashed #4b514b; border-radius:6rpx; background:#141614; }.link-source textarea { width:100%; flex:1; min-height:0; box-sizing:border-box; color:#f3f5f1; font-size:22rpx; line-height:1.45; }.link-source textarea::placeholder { color:#6f766f; }.link-source text { flex:none; margin-top:8rpx; color:#969d96; font-size:17rpx; }
.flow { display:flex; align-items:center; margin:14rpx 8rpx 12rpx; }.flow-item { display:flex; align-items:center; gap:6rpx; color:#6f766f; font-size:17rpx; white-space:nowrap; }.flow-item text { width:34rpx; height:34rpx; line-height:34rpx; border:1rpx solid #383d38; border-radius:4rpx; background:#191b19; text-align:center; font-size:15rpx; }.flow-item.active { color:#d8ff3e; font-weight:800; }.flow-item.active text { color:#11130d; border-color:#d8ff3e; background:#d8ff3e; }.flow-line { height:1rpx; flex:1; margin:0 9rpx; background:#383d38; }.ad-action { margin-top:10rpx; }.notice { margin-top:10rpx; color:#6f766f; text-align:center; font-size:16rpx; }
