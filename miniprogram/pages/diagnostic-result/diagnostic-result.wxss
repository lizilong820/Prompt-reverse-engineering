.result-head { display:flex; align-items:flex-start; justify-content:space-between; padding-bottom:18rpx; border-bottom:1rpx solid #383d38; }.overall { flex:none; min-width:96rpx; padding:10rpx; border:1rpx solid #d8ff3e; border-radius:5rpx; background:#d8ff3e; text-align:center; }.overall strong,.overall text { display:block; color:#11130d; }.overall strong { font-size:38rpx; }.overall text { margin-top:2rpx; font-size:15rpx; font-weight:800; }.summary { margin-top:16rpx; color:#f3f5f1; font-size:22rpx; line-height:1.6; }.scores { display:grid; gap:9rpx; margin-top:18rpx; }.score { padding:14rpx; border:1rpx solid #383d38; border-radius:5rpx; background:#191b19; }.score > view { display:flex; justify-content:space-between; margin-bottom:8rpx; }.score text { color:#969d96; font-size:18rpx; }.score strong { color:#d8ff3e; font-size:20rpx; }.difference-block,.prompt-block { margin-top:18rpx; padding:18rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.block-title { color:#969d96; font-size:18rpx; font-weight:800; }.difference { margin-top:15rpx; padding-top:15rpx; border-top:1rpx solid #383d38; }.difference-head { display:flex; justify-content:space-between; }.difference-head strong { color:#f3f5f1; font-size:21rpx; }.difference-head text { font-size:16rpx; font-weight:800; }.difference-head .high { color:#ff6b57; }.difference-head .medium { color:#ffc857; }.difference-head .low { color:#d8ff3e; }.difference > text { display:block; margin-top:9rpx; color:#f3f5f1; font-size:19rpx; line-height:1.5; }.difference label { display:inline-block; width:100rpx; color:#969d96; }.difference > view:last-child { margin-top:10rpx; padding-left:11rpx; border-left:3rpx solid #d8ff3e; color:#d8ff3e; font-size:19rpx; line-height:1.5; }.prompt-head { display:flex; align-items:center; justify-content:space-between; }.prompt-head button { margin:0; padding:0 17rpx; height:50rpx; line-height:50rpx; border-radius:4rpx; color:#11130d; background:#d8ff3e; font-size:18rpx; font-weight:800; }.language-switch { display:flex; gap:6rpx; margin:14rpx 0; }.language-switch button { margin:0; padding:0 15rpx; height:46rpx; line-height:46rpx; border:1rpx solid #383d38; border-radius:4rpx; color:#969d96; background:#141614; font-size:18rpx; }.language-switch button.active { color:#11130d; border-color:#d8ff3e; background:#d8ff3e; font-weight:800; }.prompt-block > text { color:#f3f5f1; font-size:21rpx; line-height:1.7; }
