.feedback-page{padding-bottom:60rpx}.meta{margin-top:14rpx;color:#969d96;font-size:18rpx}.category{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:24rpx}.chip{padding:12rpx 18rpx;border:1rpx solid #383d38;border-radius:4rpx;color:#969d96;font-size:19rpx}.chip.active{border-color:#d8ff3e;color:#11130d;background:#d8ff3e}.content{box-sizing:border-box;width:100%;height:260rpx;margin-top:18rpx;padding:18rpx;border:1rpx solid #383d38;border-radius:6rpx;color:#f3f5f1;background:#191b19;font-size:21rpx}.primary{margin-top:18rpx}.history{margin-top:30rpx}.ticket{display:grid;grid-template-columns:1fr auto;gap:7rpx;margin-top:12rpx;padding:16rpx;border:1rpx solid #383d38;border-radius:6rpx;background:#191b19}.ticket strong,.ticket text{display:block}.ticket text{margin-top:7rpx;color:#969d96;font-size:18rpx;line-height:1.45}.ticket .status{color:#d8ff3e}.ticket .reply{grid-column:1/-1;color:#f3f5f1}
