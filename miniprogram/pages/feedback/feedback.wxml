<view class="page feedback-page"><view class="eyebrow">FEEDBACK</view><view class="section-title">提交反馈</view><view class="meta">关联任务：{{taskType}} #{{taskId}}</view><view class="category"><view wx:for="{{categories}}" wx:key="key" class="chip {{category === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="chooseCategory">{{item.label}}</view></view><textarea class="content" maxlength="2000" placeholder="请描述遇到的问题或改进建议" value="{{content}}" bindinput="onInput"/><button class="primary" bindtap="submit" disabled="{{submitting || content.length < 5}}">{{submitting ? '提交中' : '提交反馈'}}</button><view wx:if="{{tickets.length}}" class="history"><view class="block-title">我的反馈</view><view wx:for="{{tickets}}" wx:key="id" class="ticket"><view><strong>{{item.category}}</strong><text>{{item.content}}</text></view><text class="status">{{item.status}}</text><text wx:if="{{item.reply}}" class="reply">回复：{{item.reply}}</text></view></view></view>
