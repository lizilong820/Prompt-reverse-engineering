.diagnostic-page { padding-top:22rpx; }.page-head { padding-bottom:18rpx; border-bottom:1rpx solid #383d38; }.page-head > text:last-child { display:block; margin-top:9rpx; color:#969d96; font-size:18rpx; }.balance-row { display:flex; justify-content:space-between; margin:14rpx 0; padding:11rpx 14rpx; border:1rpx solid #383d38; border-radius:6rpx; color:#d8ff3e; background:#191b19; font-size:18rpx; font-weight:800; }.video-field { margin-top:14rpx; }.field-head { display:flex; justify-content:space-between; margin-bottom:8rpx; }.field-head strong { color:#f3f5f1; font-size:21rpx; }.field-head text { color:#969d96; font-size:17rpx; }.video-box { box-sizing:border-box; width:100%; height:220rpx; overflow:hidden; border:1rpx dashed #4b514b; border-radius:6rpx; background:#141614; }.video-box.has-video { border-style:solid; }.video-box video { width:100%; height:100%; }.video-box > view { display:flex; height:100%; flex-direction:column; align-items:center; justify-content:center; }.video-box strong,.video-box small { display:block; }.video-box strong { margin-top:8rpx; color:#f3f5f1; font-size:21rpx; }.video-box small { margin-top:6rpx; color:#969d96; font-size:16rpx; }.upload-symbol { width:46rpx; height:46rpx; line-height:42rpx; border:1rpx solid #d8ff3e; border-radius:4rpx; color:#d8ff3e; text-align:center; font-size:27rpx; }.file-name { display:block; margin-top:6rpx; overflow:hidden; color:#969d96; text-overflow:ellipsis; white-space:nowrap; font-size:16rpx; }.upload-state { margin:15rpx 0; }.upload-state text { display:block; margin-bottom:8rpx; color:#d8ff3e; font-size:18rpx; }.primary { margin-top:18rpx; }.notice { display:block; margin-top:10rpx; color:#6f766f; text-align:center; font-size:16rpx; }
