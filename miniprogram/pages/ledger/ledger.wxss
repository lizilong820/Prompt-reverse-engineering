.page-header { display:flex; align-items:flex-end; justify-content:space-between; padding-bottom:20rpx; border-bottom:1rpx solid #383d38; }.count { color:#d8ff3e; font-size:20rpx; font-weight:800; }
.ledger { margin-top:12rpx; }.entry { display:flex; align-items:center; justify-content:space-between; gap:18rpx; min-height:94rpx; padding:16rpx 2rpx; border-bottom:1rpx solid #383d38; }.entry-copy { min-width:0; }.entry strong,.entry small { display:block; }.entry strong { color:#f3f5f1; font-size:23rpx; }.entry small { margin-top:7rpx; color:#969d96; font-size:18rpx; }.amount { flex:none; text-align:right; font-size:28rpx; font-weight:800; }.amount.plus { color:#d8ff3e; }.amount.minus { color:#ff6b57; }
