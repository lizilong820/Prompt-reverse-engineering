<view class="page projects-page">
  <view class="page-header"><view><text class="eyebrow">CREATIVE PROJECTS</text><view class="section-title">创作项目</view></view><text class="count">{{projects.length}} 个</text></view>
  <view wx:if="{{projects.length}}" class="project-list"><view wx:for="{{projects}}" wx:key="id" class="project-card" data-id="{{item.id}}" bindtap="openProject"><view class="project-mark">{{item.is_favorite ? '★' : '·'}}</view><view class="project-copy"><strong>{{item.title}}</strong><text>{{item.version_count}} 个提示词版本 · {{item.recent_platform}}</text><small>{{item.note || '暂无备注'}}</small></view><text class="project-arrow">›</text></view></view>
  <view wx:elif="{{!loading}}" class="empty">还没有收藏项目</view>
  <view wx:if="{{active}}" class="project-detail"><view class="detail-head"><view><text class="eyebrow">PROJECT</text><view class="section-title">{{active.title}}</view></view><button bindtap="closeProject">关闭</button></view><view class="detail-actions"><button bindtap="editProject">改标题</button><button bindtap="editNote">改备注</button><button bindtap="toggleFavorite">{{active.is_favorite ? '取消收藏' : '收藏'}}</button><button data-format="txt" bindtap="exportProject">TXT</button><button data-format="json" bindtap="exportProject">JSON</button><button class="danger" bindtap="deleteProject">删除</button></view><view class="note">{{active.note || '暂无备注'}}</view><view class="version" wx:for="{{active.versions}}" wx:key="id"><view class="version-head"><strong>{{item.label}}</strong><text>{{item.platform}}</text></view><text selectable>{{item.prompt_zh}}</text><view><button data-id="{{item.id}}" data-lang="zh" bindtap="copy">复制中文</button><button data-id="{{item.id}}" data-lang="en" bindtap="copy">复制英文</button></view></view></view>
</view>
