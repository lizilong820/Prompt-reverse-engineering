.projects-page { position:relative; }.page-header { display:flex; align-items:flex-end; justify-content:space-between; padding-bottom:18rpx; border-bottom:1rpx solid #383d38; }.count { color:#d8ff3e; font-size:18rpx; }.project-list { display:grid; gap:9rpx; margin-top:16rpx; }.project-card { display:flex; align-items:center; gap:12rpx; padding:15rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.project-mark { width:48rpx; height:48rpx; line-height:48rpx; flex:none; color:#11130d; background:#d8ff3e; border-radius:4rpx; text-align:center; font-size:24rpx; }.project-copy { min-width:0; flex:1; }.project-copy strong,.project-copy text,.project-copy small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.project-copy strong { color:#f3f5f1; font-size:22rpx; }.project-copy text,.project-copy small { margin-top:5rpx; color:#969d96; font-size:17rpx; }.project-arrow { color:#d8ff3e; font-size:38rpx; }.project-detail { position:fixed; z-index:5; inset:0; overflow:auto; padding:24rpx 30rpx 60rpx; background:#101110; }.detail-head { display:flex; align-items:flex-start; justify-content:space-between; padding-bottom:16rpx; border-bottom:1rpx solid #383d38; }.detail-head button,.detail-actions button,.version button { margin:0; padding:0 12rpx; height:48rpx; line-height:48rpx; border:1rpx solid #383d38; border-radius:4rpx; color:#f3f5f1; background:#191b19; font-size:17rpx; }.detail-actions { display:flex; flex-wrap:wrap; gap:7rpx; margin:15rpx 0; }.detail-actions .danger { color:#ff6b57; border-color:#ff6b57; }.note { padding:13rpx; border-left:3rpx solid #d8ff3e; color:#969d96; font-size:18rpx; line-height:1.5; }.version { margin-top:16rpx; padding:15rpx; border:1rpx solid #383d38; border-radius:6rpx; background:#191b19; }.version-head { display:flex; justify-content:space-between; margin-bottom:10rpx; }.version-head strong { color:#f3f5f1; font-size:20rpx; }.version-head text { color:#d8ff3e; font-size:17rpx; }.version > text { color:#f3f5f1; font-size:20rpx; line-height:1.65; }.version > view:last-child { display:flex; gap:6rpx; margin-top:12rpx; }
